# Copy to .env.local (NEVER commit .env.local)
# Local Postgres (Docker) — used by /api/providers + /api/appointments.
# Server-only (no NEXT_PUBLIC_ prefix). Matches docker-compose defaults.
DATABASE_URL=postgres://maheba:maheba@localhost:5432/maheba

# Server-only (no NEXT_PUBLIC_ prefix) — used by /api/mpesa/* via service role
# SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
